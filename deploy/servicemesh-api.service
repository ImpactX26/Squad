# The FastAPI backend, 127.0.0.1:8000, one worker: the event bus lives in memory (ARCHITECTURE.md §2, §17.2).
# Install: sudo cp deploy/servicemesh-*.service /etc/systemd/system/ && sudo systemctl daemon-reload

[Unit]
Description=ServiceMesh API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/Squad/backend
# uv from its installer (~/.local/bin), pnpm and node; systemd sets HOME from User=.
Environment=PATH=/home/deploy/.local/bin:/home/deploy/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin
# --proxy-headers: the client address comes from Caddy's X-Forwarded-For (the pay API's rate limit, §7.6).
ExecStart=/usr/bin/env uv run uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
